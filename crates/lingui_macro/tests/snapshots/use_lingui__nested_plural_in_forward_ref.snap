import { useLingui as $_useLingui } from "@lingui/react";
const Component = forwardRef(()=>{
    const { _: $__ } = $_useLingui();
    return $__(/*i18n*/ {
        id: "oDeoLE",
        message: "Selected {count, plural, one {# item} other {# items}}",
        values: {
            count: count
        }
    });
});
