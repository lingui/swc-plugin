import { useLingui } from "@lingui/react/macro";
import { plural } from "@lingui/core/macro";

export function Label({ n, box }) {
  const { t } = useLingui();
  return t`${plural(n, { one: '# item', other: '# items' })} in ${box || t`Box`}`;
}

