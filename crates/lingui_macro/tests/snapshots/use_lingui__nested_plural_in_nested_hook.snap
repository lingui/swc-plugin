import { useLingui } from "@lingui/react/macro";
import { plural } from "@lingui/core/macro";

function Outer() {
  const { t } = useLingui();
  const label = t`Outer`;
  return wrap(() => {
    const { t } = useLingui();
    return t`Selected ${plural(count, { one: '# item', other: '# items' })}`;
  });
}

